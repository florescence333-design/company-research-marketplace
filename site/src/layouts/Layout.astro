---
const { title = 'Company Research' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root { font-family:'DM Sans','Noto Sans KR',sans-serif; color:#e8eee8; background:#101918; }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; }
  a { color:inherit; text-decoration:none; }
  button { font:inherit; cursor:pointer; }
  .shell { min-height:100vh; display:grid; grid-template-columns:236px minmax(0,1fr); }
  aside { background:#111b1a; border-right:1px solid #293735; padding:30px 18px; }
  .brand { display:flex; align-items:center; gap:11px; padding:2px 12px 34px; font-size:15px; letter-spacing:.02em; font-weight:700; }
  .brand-mark { width:28px; height:28px; border:1px solid #9dc9bd; color:#9dc9bd; border-radius:8px; display:grid; place-items:center; font:600 16px 'IBM Plex Mono'; }
  .aside-label { color:#6f8580; text-transform:uppercase; letter-spacing:.16em; font:500 10px 'IBM Plex Mono'; padding:0 12px; margin:10px 0 12px; }
  .nav-link { display:flex; padding:12px; gap:10px; color:#94aaa4; border-radius:9px; font-size:13px; }
  .nav-link.active { color:#d9f3e8; background:#1f3330; }
  .nav-link:hover { color:#fff; background:#23312f; }
  .sidebar-note { margin:42px 12px 0; border-top:1px solid #30413d; padding-top:20px; color:#708780; font-size:11px; line-height:1.6; }
  main { min-width:0; }
  .topbar { height:72px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #293735; padding:0 42px; color:#9ab1aa; font-size:12px; }
  .topbar strong { color:#dceae3; font-weight:500; }
  .avatar { width:30px; height:30px; border-radius:50%; background:#213b35; display:grid; place-items:center; color:#aee0c8; font-size:11px; }
  .content { max-width:1320px; margin:auto; padding:42px; }
  .eyebrow { color:#86b9aa; font:500 11px 'IBM Plex Mono'; letter-spacing:.18em; text-transform:uppercase; }
  h1 { font-size:36px; letter-spacing:-.045em; margin:12px 0 10px; font-weight:600; }
  h2 { font-size:19px; letter-spacing:-.025em; margin:0; font-weight:600; }
  p { line-height:1.7; }
  .muted { color:#8ba39d; }
  .mono { font-family:'IBM Plex Mono',monospace; }
  .panel { border:1px solid #30413e; border-radius:13px; background:#172320; }
  .badge { display:inline-flex; align-items:center; padding:6px 10px; border-radius:6px; background:#243830; color:#a5d9bd; font-size:11px; font-weight:600; }
  .sample { background:#493b23; color:#f1c982; }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; background:#b7e4cd; color:#14271f; border:0; border-radius:8px; padding:11px 15px; font-size:12px; font-weight:700; }
  .btn:hover { background:#d4f5e5; }
  @media(max-width:920px) { .shell { grid-template-columns:1fr; } aside { display:none; } .topbar { padding:0 20px; } .content { padding:30px 20px; } }
</style>
