---
import Layout from '../../layouts/Layout.astro';
import { loadCompany } from '../../lib/data.mjs';
import { compareReports } from '../../lib/comparison.mjs';

const versions = loadCompany('RKLB');
const comparison = compareReports(versions);
const initialEngine = versions.gpt ? 'gpt' : 'claude';
const current = versions[initialEngine];
const isSample = Object.values(versions).every(v => v.meta.sample);
const statusLabel = status => ({ complete: '작성 완료', partial: '부분 작성', unavailable: '자료 확인 대기' })[status] || '자료 확인 대기';
const metricDisplay = (version, id) => {
  const fact = version.metrics.find(item => item.metric_id === id);
  if (!fact || fact.status !== 'ok' || typeof fact.value !== 'number') return '확인 불가';
  return `${fact.value.toLocaleString('ko-KR')}${fact.unit === '%' ? '%' : ''}${fact.approximate ? ' (근사)' : ''}`;
};
const lossPeDisplay = version => {
  const eps = version.metrics.find(item => item.metric_id === 'eps_ttm');
  return eps?.status === 'ok' && typeof eps.value === 'number' && eps.value <= 0
    ? '적자 기업 · 비율 의미 없음' : null;
};
const annualRevenue = current.metrics.filter(m => /^revenue_fy\d{4}$/.test(m.metric_id) && m.status === 'ok' && typeof m.value === 'number').sort((a, b) => a.metric_id.localeCompare(b.metric_id));
---
<Layout title="RKLB 분석 · Company Research">
  <div class="shell">
    <aside>
      <a class="brand" href="/"><span class="brand-mark">R</span><span>RESEARCH / LAB</span></a>
      <div class="aside-label">Workspace</div>
      <a class="nav-link" href="/">▦ &nbsp; 기업 목록</a>
      <a class="nav-link active" href="/company/RKLB/">⌁ &nbsp; RKLB 분석</a>
      <div class="sidebar-note">투자 결론은 판정 세부 기준 확정 후 제공합니다.<br/>Decision policy v0.1</div>
    </aside>
    <main data-versions={JSON.stringify(versions)}>
      <div class="topbar"><span><a href="/">COMPANIES</a> <span class="muted">/ RKLB</span></span><span class="avatar">R</span></div>
      <div class="content">
        <div class="intro-row">
          <div>
            <div class="eyebrow">Company profile / NASDAQ</div>
            <h1>Rocket Lab <span class="ticker">RKLB</span></h1>
            <p class="muted subtitle">기업 공시·재무 상태·분석 근거를 한 화면에서 확인합니다.</p>
          </div>
          <div class="engine-switch" role="group" aria-label="분석 엔진">
            {Object.keys(versions).map(engine => <button type="button" class={engine === initialEngine ? 'active' : ''} data-engine={engine}>{engine === 'gpt' ? 'GPT판' : 'Claude판'}{versions[engine].meta.model ? '' : ' 초안'}</button>)}
          </div>
        </div>

        <div class="status-line">
          {isSample && <span class="badge sample">샘플 데이터</span>}
          <span class="badge">US-GAAP 범위</span>
          <span class="badge" id="analysis-mode">{current.meta.model ? 'AI 분석 포함' : '공시·코드 초안 · AI 평가 미실행'}</span>
          <span class="muted">분석 기준: <span id="as-of">{current.meta.analysis_as_of || '실제 데이터 수집 전'}</span></span>
        </div>

        <section class="decision-panel panel" aria-labelledby="verdict-title">
          <div>
            <div class="eyebrow">Investment decision / v0.1</div>
            <h2 id="verdict-title">판정 보류 (v0.1)</h2>
            <p id="verdict-reason">{current.decision.reason}</p>
          </div>
          <div class="decision-side">
            <span>사업 품질</span><strong>평가 대기</strong>
            <span>가격 적정성</span><strong>계산 대기</strong>
          </div>
        </section>

        <section class="panel market-chart" aria-labelledby="price-chart-title">
          <div class="chart-heading"><div><div class="eyebrow">Market / NASDAQ:RKLB</div><h2 id="price-chart-title">주가 차트</h2></div><span>TradingView 무료 위젯 · 표시 지연 가능</span></div>
          <div class="tradingview-widget-container"><div id="tradingview-chart" class="tradingview-widget-container__widget">차트 불러오는 중</div><div class="tradingview-credit"><a href="https://www.tradingview.com/symbols/NASDAQ-RKLB/" target="_blank" rel="noopener nofollow noreferrer">RKLB chart by TradingView ↗</a></div></div>
          <p class="market-note">시장 수치는 TradingView가 제공하는 항목과 시점에 따릅니다. SEC 재무 지표의 기준일과 다를 수 있습니다.</p>
        </section>

        <section class="panel market-widgets" aria-labelledby="market-widgets-title">
          <div class="chart-heading"><div><div class="eyebrow">Market snapshot / NASDAQ:RKLB</div><h2 id="market-widgets-title">시장 정보</h2></div><span>TradingView 무료 위젯 · 항목별 제공 여부는 TradingView 기준</span></div>
          <div class="market-widget-grid">
            <div class="market-widget"><h3>주가·기업 정보</h3><div id="tradingview-symbol-info" class="tradingview-widget-container"><div class="tradingview-widget-container__widget">시장 정보 불러오는 중</div></div></div>
            <div class="market-widget"><h3>기업 재무 지표</h3><div id="tradingview-fundamentals" class="tradingview-widget-container"><div class="tradingview-widget-container__widget">기업 지표 불러오는 중</div></div></div>
          </div>
          <p class="market-note">주가·시가총액·PER·52주 범위·배당은 위젯에서 제공하는 항목만 표시합니다. 좁은 화면에서는 기업 재무 지표를 좌우로 스크롤하세요. 별도 시장 수치를 저장하거나 게시하지 않습니다.</p>
        </section>

        <div class="tabs" role="tablist" aria-label="기업 분석 내용">
          {['보고서','재무','시각화','템플릿','출처·데이터','비교'].map((name, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} class={i === 0 ? 'active' : ''}>{name}</button>)}
        </div>
        <div class="panel tab-panel" data-panel="0">
          <h2>기업 분석 보고서</h2>
          <p class="muted">확인 가능한 자료와 근거를 기준으로 표시합니다.</p>
          <p class="report-quality-note">기준 보고서 대비 정량 분석(제품별 원가·고객 경제성 등)은 보강 예정</p>
          <nav id="report-toc" class="report-toc" aria-label="보고서 목차">
            {current.reportItems.flatMap(section => [section, ...(section.subsections || [])]).map(section => <a href={`#report-${section.section_id}`}><span>{section.section_id} · {section.title}</span><small>{statusLabel(section.status)}</small></a>)}
          </nav>
          <div id="report-sections" class="report-sections">
            {current.reportItems.length ? current.reportItems.map(section =>
              <article class="report-section" id={`report-${section.section_id}`}>
                <div class="report-section-head"><h3>{section.section_id} · {section.title}</h3><span class="report-status">{statusLabel(section.status)}</span></div>
                <div class="report-body">{section.body}</div>
                {section.source_ids.length > 0 && <div class="report-sources">출처 ID: {section.source_ids.join(', ')}</div>}
                {section.subsections?.map(sub => <section class="report-subsection" id={`report-${sub.section_id}`}><div class="report-section-head"><h3>{sub.section_id} · {sub.title}</h3><span class="report-status">{statusLabel(sub.status)}</span></div><div class="report-body">{sub.body}</div>{sub.source_ids.length > 0 && <div class="report-sources">출처 ID: {sub.source_ids.join(', ')}</div>}</section>)}
              </article>) : <p class="muted">16단계 Master Template 준비 완료 · 이 엔진의 실제 분석 보고서는 아직 생성되지 않았습니다.</p>}
          </div>
          <details class="report-original"><summary>보고서 원문 보기</summary><pre id="report-text">{current.report || '미생성'}</pre></details>
        </div>
        <div class="panel tab-panel" data-panel="1" hidden>
          <h2>재무 데이터</h2><p class="muted">출처가 확인된 지표만 표시합니다. 없는 값은 0으로 채우지 않습니다.</p>
          <div class="section-heading finance-heading"><h3>재무분석</h3><span class="muted">SEC metrics.json · 최근 공시 기준</span></div>
          <div class="financial-grid" id="financial-cards">{current.dashboard.cards.map(card => <div class="panel financial-card"><span>{card.label}</span><strong>{card.value}</strong><small>{card.detail}</small></div>)}</div>
          <div class="warning-line" id="warning-line"><span>경고 신호</span>{current.dashboard.warnings.length ? current.dashboard.warnings.map(warning => <strong>{warning}</strong>) : <strong>현재 계산 가능한 경고 없음</strong>}</div>
          <div class="sec-snapshot"><div><span>SEC 기준 EPS (TTM)</span><strong id="sec-eps-ttm">{metricDisplay(current,'eps_ttm')}</strong><small>공시 수치 기반 · 근사 여부 별도 표시</small></div><div id="sec-pe-wrap" hidden={!lossPeDisplay(current)}><span>SEC 기준 PER 상태</span><strong id="sec-pe-status">{lossPeDisplay(current)}</strong><small>적자일 때 배수로 해석하지 않음</small></div></div>
          <div class="revenue-chart"><h3>연간 매출 추이</h3><div id="revenue-bars">{annualRevenue.map(m => <div class="revenue-bar"><span>{m.metric_id.slice(-4)}</span><div><i style={`width:${Math.max(2, Math.round(m.value / Math.max(...annualRevenue.map(x => x.value)) * 100))}%`}></i></div><strong>{(m.value / 1_000_000).toFixed(1)}M USD</strong></div>)}</div></div>
          <div id="financial-rows" class="data-rows">{current.metrics.length ? current.metrics.map(m => <div><span>{m.metric_id}</span><strong>{m.status === 'ok' ? m.value : '확인 불가'}</strong></div>) : <span>아직 검증된 재무 수치가 없습니다.</span>}</div>
        </div>
        <div class="panel tab-panel" data-panel="2" hidden><h2>사업 시각화</h2><p class="muted">보고서의 사업 구조·커스텀 분석·확장성 근거를 바탕으로 그립니다.</p><div id="diagram-panels">{Object.keys(current.diagrams).length ? '도식 준비 중' : '보고서 분석 완료 후 생성'}</div></div>
        <div class="panel tab-panel" data-panel="3" hidden><h2>기업별 커스텀 프레임워크</h2><p class="muted">적합성 판정과 원본 대비 구분표, 16개 대섹션·추가 하위 섹션의 상세 질문입니다.</p><div id="template-render" class="template-render"></div><pre id="template-text" class="template-text">{current.template || 'S0.5 커스텀 템플릿 작성 대기'}</pre></div>
        <div class="panel tab-panel" data-panel="4" hidden><h2>출처·데이터</h2><p class="muted">보고서의 출처 ID를 아래 공시 위치와 대조할 수 있습니다.</p><div id="source-rows" class="data-rows">{current.sources.length ? current.sources.map(s => <div class="source-row"><span><code>{s.source_id}</code><strong>{s.title}</strong><small>{s.location}</small></span><a href={s.url} target="_blank" rel="noopener noreferrer">원문 ↗</a></div>) : <span>표시할 검증 출처가 없습니다.</span>}</div></div>
        <div class="panel tab-panel" data-panel="5" hidden><h2>두 엔진 비교</h2><p class="muted">같은 섹션의 작성 범위와 웹 근거 수를 비교합니다. 사업 품질 항목별 평가는 v0.1에서 아직 실행하지 않았습니다.</p><div class="compare"><div><span>CLAUDE판</span><strong>{versions.claude ? versions.claude.decision.verdict : '미생성'}</strong><small>{versions.claude?.meta.analysis_as_of || '기준일 없음'}</small></div><div><span>GPT판</span><strong>{versions.gpt ? versions.gpt.decision.verdict : '미생성'}</strong><small>{versions.gpt?.meta.analysis_as_of || '기준일 없음'}</small></div></div><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>섹션</th><th>Claude판</th><th>GPT판</th><th>차이</th></tr></thead><tbody>{comparison.map(row => <tr><th>{row.id} {row.title}</th><td>{row.claude.status} · 웹 {row.claude.webSources}건 · {row.claude.length.toLocaleString('ko-KR')}자</td><td>{row.gpt.status} · 웹 {row.gpt.webSources}건 · {row.gpt.length.toLocaleString('ko-KR')}자</td><td>{row.difference}</td></tr>)}</tbody></table></div></div>
        <p class="page-footnote">판정 기준 v1의 세부 규칙이 미정입니다. 이 화면의 v0.1 보류 표시는 투자 권고가 아닙니다.</p>
      </div>
    </main>
  </div>
  <script>
    import mermaid from 'mermaid';
    import { diagramWidth, styleDiagramNodes } from '../../lib/diagram-style.mjs';
    import { Marked } from 'marked';
    import DOMPurify from 'dompurify';
    const main = document.querySelector('main[data-versions]');
    const versions = JSON.parse(main.dataset.versions);
    mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'strict', flowchart: { nodeSpacing: 56, rankSpacing: 70, wrappingWidth: 180, diagramPadding: 16 } });
    let diagramSequence = 0;
    const markdown = new Marked({ gfm: true });
    markdown.use({ renderer: { html() { return ''; } } });
    function safeMarkdown(source) { return DOMPurify.sanitize(markdown.parse(source || '')); }
    function reportMarkdown(source) {
      const tokens = markdown.lexer(source || '');
      for (const token of tokens) if (token.type === 'heading') token.depth = Math.min(6, token.depth + 1);
      return DOMPurify.sanitize(markdown.parser(tokens));
    }
    function highlightCitations(container) {
      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      const pattern = /\[(?:\s*(?:web|sec)-[A-Za-z0-9-]+\s*,?)+\]/g;
      for (const node of nodes) {
        if (node.parentElement?.closest('a, code, pre')) continue;
        const value = node.nodeValue;
        pattern.lastIndex = 0;
        if (!pattern.test(value)) continue;
        pattern.lastIndex = 0;
        const fragment = document.createDocumentFragment();
        let cursor = 0;
        for (const match of value.matchAll(pattern)) {
          fragment.append(document.createTextNode(value.slice(cursor, match.index)));
          const citation = document.createElement('span');
          citation.className = 'inline-citation';
          citation.textContent = match[0];
          fragment.append(citation);
          cursor = match.index + match[0].length;
        }
        fragment.append(document.createTextNode(value.slice(cursor)));
        node.replaceWith(fragment);
      }
    }
    function renderSecSnapshot(version) {
      const eps = version.metrics.find(metric => metric.metric_id === 'eps_ttm');
      document.querySelector('#sec-eps-ttm').textContent = eps?.status === 'ok' && typeof eps.value === 'number'
        ? `${eps.value.toLocaleString('ko-KR')}${eps.approximate ? ' (근사)' : ''}` : '확인 불가';
      const loss = eps?.status === 'ok' && typeof eps.value === 'number' && eps.value <= 0;
      document.querySelector('#sec-pe-wrap').hidden = !loss;
      document.querySelector('#sec-pe-status').textContent = loss ? '적자 기업 · 비율 의미 없음' : '';
    }
    function renderFinancialDashboard(dashboard) {
      const cards = document.querySelector('#financial-cards');
      cards.replaceChildren(...dashboard.cards.map(card => {
        const item = document.createElement('div'); item.className = 'panel financial-card';
        const label = document.createElement('span'); label.textContent = card.label;
        const value = document.createElement('strong'); value.textContent = card.value;
        const detail = document.createElement('small'); detail.textContent = card.detail;
        item.append(label, value, detail); return item;
      }));
      const warnings = document.querySelector('#warning-line');
      const heading = document.createElement('span'); heading.textContent = '경고 신호';
      warnings.replaceChildren(heading, ...(dashboard.warnings.length ? dashboard.warnings : ['현재 계산 가능한 경고 없음']).map(line => { const item = document.createElement('strong'); item.textContent = line; return item; }));
    }
    function mountTradingView() {
      const host = document.querySelector('#tradingview-chart');
      host.replaceChildren();
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
      script.textContent = JSON.stringify({ autosize: true, symbol: 'NASDAQ:RKLB', interval: 'D', timezone: 'exchange', theme: 'dark', style: '1', locale: 'en', hide_side_toolbar: true, allow_symbol_change: false, save_image: false, calendar: false });
      script.onerror = () => { host.textContent = '차트를 불러오지 못했습니다. TradingView에서 RKLB 차트를 확인하세요.'; };
      host.append(script);
    }
    function mountMarketWidget(selector, filename, settings) {
      const host = document.querySelector(selector);
      const widget = host.querySelector('.tradingview-widget-container__widget');
      widget.replaceChildren();
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://s3.tradingview.com/external-embedding/${filename}`;
      script.textContent = JSON.stringify(settings);
      script.onerror = () => { host.closest('.market-widget').hidden = true; };
      host.append(script);
    }
    mountTradingView();
    mountMarketWidget('#tradingview-symbol-info', 'embed-widget-symbol-info.js', { symbol: 'NASDAQ:RKLB', width: '100%', locale: 'en', colorTheme: 'dark', isTransparent: true });
    mountMarketWidget('#tradingview-fundamentals', 'embed-widget-financials.js', { symbol: 'NASDAQ:RKLB', width: '100%', height: 420, locale: 'en', colorTheme: 'dark', isTransparent: true, displayMode: 'adaptive' });
    function renderTemplate(source) {
      const target = document.querySelector('#template-render');
      const fallback = document.querySelector('#template-text');
      if (!source) { target.textContent = 'S0.5 커스텀 템플릿 작성 대기'; fallback.hidden = true; return; }
      target.innerHTML = safeMarkdown(source);
      fallback.hidden = true;
    }
    const initialVersion = versions[document.querySelector('[data-engine].active').dataset.engine];
    renderTemplate(initialVersion.template);
    renderReportSections(initialVersion.reportItems);
    function renderReportSections(items) {
      const statusLabel = status => ({ complete: '작성 완료', partial: '부분 작성', unavailable: '자료 확인 대기' })[status] || '자료 확인 대기';
      const target = document.querySelector('#report-sections');
      const toc = document.querySelector('#report-toc');
      target.replaceChildren();
      toc.replaceChildren();
      if (!items.length) { target.textContent = '이 엔진의 실제 분석 보고서는 아직 생성되지 않았습니다.'; return; }
      for (const section of items) {
        const tocLink = document.createElement('a');
        tocLink.href = `#report-${section.section_id}`;
        const tocName = document.createElement('span');
        tocName.textContent = `${section.section_id} · ${section.title}`;
        const tocStatus = document.createElement('small');
        tocStatus.textContent = statusLabel(section.status);
        tocLink.append(tocName, tocStatus);
        toc.append(tocLink);
        for (const sub of section.subsections || []) {
          const subLink = document.createElement('a');
          subLink.href = `#report-${sub.section_id}`;
          subLink.className = 'toc-subsection';
          const name = document.createElement('span'); name.textContent = `${sub.section_id} · ${sub.title}`;
          const state = document.createElement('small'); state.textContent = statusLabel(sub.status);
          subLink.append(name, state); toc.append(subLink);
        }
        const article = document.createElement('article');
        article.className = 'report-section';
        article.id = `report-${section.section_id}`;
        const heading = document.createElement('div');
        heading.className = 'report-section-head';
        const title = document.createElement('h3');
        title.textContent = `${section.section_id} · ${section.title}`;
        const status = document.createElement('span');
        status.className = 'report-status';
        status.textContent = statusLabel(section.status);
        heading.append(title, status);
        const body = document.createElement('div');
        body.className = 'report-body';
        body.innerHTML = reportMarkdown(section.body);
        highlightCitations(body);
        article.append(heading, body);
        if (section.source_ids.length) {
          const sources = document.createElement('div');
          sources.className = 'report-sources';
          sources.textContent = `출처 ID: ${section.source_ids.join(', ')}`;
          article.append(sources);
        }
        for (const sub of section.subsections || []) {
          const subBlock = document.createElement('section');
          subBlock.className = 'report-subsection';
          subBlock.id = `report-${sub.section_id}`;
          const subHeading = document.createElement('div');
          subHeading.className = 'report-section-head';
          const subTitle = document.createElement('h3');
          subTitle.textContent = `${sub.section_id} · ${sub.title}`;
          const subStatus = document.createElement('span');
          subStatus.className = 'report-status';
          subStatus.textContent = statusLabel(sub.status);
          subHeading.append(subTitle, subStatus);
          const subBody = document.createElement('div');
          subBody.className = 'report-body';
          subBody.innerHTML = reportMarkdown(sub.body);
          highlightCitations(subBody);
          subBlock.append(subHeading, subBody);
          if (sub.source_ids.length) {
            const subSources = document.createElement('div');
            subSources.className = 'report-sources';
            subSources.textContent = `출처 ID: ${sub.source_ids.join(', ')}`;
            subBlock.append(subSources);
          }
          article.append(subBlock);
        }
        target.append(article);
      }
    }
    function renderSources(items) {
      const target = document.querySelector('#source-rows');
      target.replaceChildren();
      if (!items.length) { target.textContent = '표시할 검증 출처가 없습니다.'; return; }
      for (const source of items) {
        const row = document.createElement('div');
        row.className = 'source-row';
        const label = document.createElement('span');
        const id = document.createElement('code');
        id.textContent = source.source_id;
        const title = document.createElement('strong');
        title.textContent = source.title;
        const location = document.createElement('small');
        location.textContent = source.location;
        label.append(id, title, location);
        const link = document.createElement('a');
        link.textContent = '원문 ↗';
        if (source.url.startsWith('https://')) {
          link.href = source.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
        row.append(label, link);
        target.append(row);
      }
    }
    async function renderDiagrams(diagrams) {
      const target = document.querySelector('#diagram-panels');
      target.replaceChildren();
      if (!Object.keys(diagrams || {}).length) { target.textContent = '보고서 분석 완료 후 생성'; return; }
      const sequence = ++diagramSequence;
      for (const [kind, diagram] of Object.entries(diagrams)) {
        const article = document.createElement('article');
        article.className = 'business-diagram';
        const title = document.createElement('h3');
        title.textContent = diagram.title || (kind === 'flywheel' ? '플라이휠' : '사업 구조·밸류체인');
        const canvas = document.createElement('div');
        canvas.className = 'diagram-canvas';
        canvas.tabIndex = 0;
        canvas.setAttribute('role', 'region');
        canvas.setAttribute('aria-label', `${title.textContent} 도식 · 가로로 스크롤 가능`);
        article.append(title, canvas);
        for (const line of diagram.explanation || []) { const p = document.createElement('p'); p.textContent = line; article.append(p); }
        const refs = document.createElement('small');
        refs.textContent = `보고서 근거: ${(diagram.section_ids || []).join(', ')}`;
        article.append(refs);
        target.append(article);
        try {
          const { svg } = await mermaid.render(`business-${kind}-${sequence}`, diagram.mermaid);
          if (sequence === diagramSequence) {
            canvas.innerHTML = svg;
            const graphic = canvas.querySelector('svg');
            styleDiagramNodes(graphic);
            if (graphic?.viewBox?.baseVal?.width) graphic.style.width = `${diagramWidth(graphic.viewBox.baseVal.width)}px`;
          }
        } catch (error) { console.error('Mermaid render error', error); canvas.textContent = '도식 렌더링 실패 · 원문을 확인하세요.'; }
      }
    }
    document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => {
      const target = button.dataset.tab;
      document.querySelectorAll('[data-tab]').forEach(tab => { tab.classList.toggle('active', tab === button); tab.setAttribute('aria-selected', String(tab === button)); });
      document.querySelectorAll('[data-panel]').forEach(panel => { panel.hidden = panel.dataset.panel !== target; });
      if (target === '2') renderDiagrams(versions[document.querySelector('[data-engine].active').dataset.engine].diagrams);
    }));
    document.querySelectorAll('[data-engine]').forEach(button => button.addEventListener('click', () => {
      const version = versions[button.dataset.engine];
      document.querySelectorAll('[data-engine]').forEach(item => item.classList.toggle('active', item === button));
      document.querySelector('#as-of').textContent = version.meta.analysis_as_of || '실제 데이터 수집 전';
      document.querySelector('#analysis-mode').textContent = version.meta.model ? 'AI 분석 포함' : '공시·코드 초안 · AI 평가 미실행';
      document.querySelector('#verdict-reason').textContent = version.decision.reason;
      document.querySelector('#report-text').textContent = version.report || '이 엔진의 실제 분석 보고서는 아직 생성되지 않았습니다.';
      renderReportSections(version.reportItems);
      if (!document.querySelector('[data-panel="2"]').hidden) renderDiagrams(version.diagrams);
      document.querySelector('#template-text').textContent = version.template || 'S0.5 커스텀 템플릿 작성 대기';
      renderTemplate(version.template);
      renderSecSnapshot(version);
      renderFinancialDashboard(version.dashboard);
      document.querySelector('#financial-rows').textContent = version.metrics.length ? version.metrics.map(m => `${m.metric_id}: ${m.status === 'ok' ? m.value : '확인 불가'}`).join(' / ') : '아직 검증된 재무 수치가 없습니다.';
      const annual = version.metrics.filter(m => /^revenue_fy\d{4}$/.test(m.metric_id) && m.status === 'ok' && typeof m.value === 'number').sort((a, b) => a.metric_id.localeCompare(b.metric_id));
