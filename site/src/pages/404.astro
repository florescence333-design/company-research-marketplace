---
import Layout from '../layouts/Layout.astro';
---
<Layout title="페이지를 찾을 수 없음 · Company Research">
  <main class="not-found">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>게시된 기업 목록에서 분석 페이지를 선택해 주세요.</p>
    <a href="/">기업 목록으로 돌아가기</a>
  </main>
</Layout>
<style>
  .not-found { max-width: 760px; margin: 14vh auto; padding: 24px; }
  .eyebrow { color: #8ca49b; font: 12px 'IBM Plex Mono', monospace; }
  h1 { margin: 18px 0; }
  a { color: #b7e4cd; }
</style>
