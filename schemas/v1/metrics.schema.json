{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1 초안: 최소 재무 지표",
  "type": "object",
  "required": ["run_id", "data_snapshot_id", "metrics"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "data_snapshot_id": {"type": "string", "minLength": 1},
    "metrics": {"type": "array", "items": {
      "type": "object",
      "required": ["metric_id", "value", "status", "unit", "approximate"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "status": {"enum": ["ok", "not_applicable", "unavailable", "collection_failed"]},
        "unit": {"type": "string", "minLength": 1},
        "approximate": {"type": "boolean"},
        "calculation": {"enum": ["annual_minus_nine_months", "annual_plus_current_ytd_minus_prior_ytd"]},
        "reason": {"type": "string", "minLength": 1},
        "period_start": {"type": "string", "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "period_match": {"type": "object", "required": ["current_period_start", "current_period_end", "prior_period_start", "prior_period_end", "expected_prior_end", "end_offset_days", "duration_delta_days", "current_accession_number", "prior_accession_number"],
          "properties": {
            "current_period_start": {"type": "string", "format": "date"},
            "current_period_end": {"type": "string", "format": "date"},
            "prior_period_start": {"type": "string", "format": "date"},
            "prior_period_end": {"type": "string", "format": "date"},
            "expected_prior_end": {"type": "string", "format": "date"},
            "end_offset_days": {"type": "integer", "minimum": -7, "maximum": 7},
            "duration_delta_days": {"type": "integer", "minimum": -7, "maximum": 7},
            "current_accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
            "prior_accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}
          }, "additionalProperties": false},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"status": {"enum": ["not_applicable", "unavailable", "collection_failed"]}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}, "approximate": {"const": false}}}}
      ],
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
