{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1 초안: 16단계 보고서 항목",
  "type": "object",
  "required": ["schema_version", "run_id", "data_snapshot_id", "sections"],
  "properties": {
    "schema_version": {"const": "v1-draft"},
    "run_id": {"type": "string", "minLength": 1},
    "data_snapshot_id": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 16, "maxItems": 16, "items": {
      "type": "object",
      "required": ["section_id", "title", "status", "body", "source_ids", "metric_ids"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-6])$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "body": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "search_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "subsections": {"type": "array", "items": {"type": "object", "required": ["section_id", "title", "status", "body", "source_ids", "metric_ids"], "properties": {
          "section_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-6])-[A-Z]$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["complete", "partial", "unavailable"]},
          "body": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "search_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }, "additionalProperties": false}}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
