{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1 초안: 로컬 게시 전 검증",
  "type": "object",
  "required": ["schema_version", "run_id", "data_snapshot_id", "checked_at", "status", "checks", "report_sha256"],
  "properties": {
    "schema_version": {"const": "v1-draft"},
    "run_id": {"type": "string", "minLength": 1},
    "data_snapshot_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
