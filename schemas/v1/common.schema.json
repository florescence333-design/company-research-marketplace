{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/research-plugin/schemas/v1/common.schema.json",
  "title": "v1 초안: 공통 형식",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "status": {"enum": ["ok", "not_applicable", "unavailable", "collection_failed"]},
    "fact": {
      "type": "object",
      "required": ["status", "value", "unit", "approximate"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "approximate": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"status": {"enum": ["not_applicable", "unavailable", "collection_failed"]}}}, "then": {"required": ["reason"], "properties": {"value": {"type": "null"}, "approximate": {"const": false}}}}
      ],
      "additionalProperties": false
    }
  }
}
